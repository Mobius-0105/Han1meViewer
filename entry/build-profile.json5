{
  "apiType": "stageMode",
  "buildOption": {
    // MPV 播放内核（@mpv-ohos/mpv-arkts，见 entry/oh-package.json5）的 HAR 带
    // arm64-v8a 的 libmpv.so / libmpv_wrapper.so / libaki_jsbind.so；真机/上架只需 arm64-v8a。
    // HAP 默认 compressNativeLibs=false（.so 不压缩），多余 ABI 会让 HAP 明显增大，
    // 因此这里排除 x86_64，只把 arm64-v8a/*.so 打进 HAP（MPV 内核本身也仅支持 arm64）。
    // 如需在 x86_64 模拟器上跑 MPV 播放，删除下面的 excludes 后重新构建即可。
    "nativeLib": {
      "filter": {
        "excludes": [
          "**/x86_64/**"
        ]
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    }
  ]
}
