{
  "apiType": "stageMode",
  // 工程内已无任何 native 库（libmpv 已整体移除，播放只用系统 AVPlayer），
  // 原先给 IJK / mpv 用的 buildOption.nativeLib.filter.excludes 已无意义，一并删除。
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    }
  ]
}
